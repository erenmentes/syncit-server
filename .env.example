PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/syncit?schema=public"

# Option A (recommended): single URL
# Examples:
# - redis://localhost:6379
# - redis://:password@localhost:6379/0
# - rediss://user:password@host:6380/0
REDIS_URL=redis://localhost:6379

# Option B: host/port fields (used if REDIS_URL is not set)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET="YOUR_JWT_SECRET"
REFRESH_TOKEN_SECRET="YOUR_REFRESH_TOKEN_SECRET"
FRONTEND_URL="http://localhost:3000" // Your frontend url for CORS

# Optional: prefix all keys with this value
REDIS_KEY_PREFIX=syncit:
